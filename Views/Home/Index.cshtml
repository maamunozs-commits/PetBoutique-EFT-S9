@{
    ViewData["Title"] = "PetBoutique";
}

<main class="py-4">
    <p class="text-uppercase text-muted">Laboratorio DevOps · ISY2201</p>
    <h1 class="display-4">PetBoutique</h1>
    <p class="lead">Un catálogo para cuidar a tus mascotas.</p>
    <p>Demostración académica. Los precios son ficticios y no se realizan compras ni pagos.</p>
    <div class="row mt-4">
        <section class="col-md-4 mb-3"><h2 class="h4">Alimento para perro</h2><p>Bolsa de 3 kg · $12.990 CLP</p></section>
        <section class="col-md-4 mb-3"><h2 class="h4">Juguete para gato</h2><p>Juego diario · $4.990 CLP</p></section>
        <section class="col-md-4 mb-3"><h2 class="h4">Correa ajustable</h2><p>Paseos cómodos · $7.990 CLP</p></section>
    </div>
    <h2 class="h4 mt-4">Cotizar sin comprar</h2>
    <form action="/api/catalog/quote" method="get">
        <label for="productId">Producto</label>
        <select id="productId" name="productId" class="form-control mb-3">
            <option value="1">Alimento para perro</option><option value="2">Juguete para gato</option><option value="3">Correa ajustable</option>
        </select>
        <label for="quantity">Cantidad (1 a 10)</label>
        <input id="quantity" name="quantity" type="number" min="1" max="10" value="1" required class="form-control mb-3" />
        <button class="btn btn-primary" type="submit">Ver cotización de demostración</button>
    </form>
    <p class="mt-4"><a href="/health">Estado del servicio</a> · <a href="/api/catalog">Catálogo JSON</a></p>
</main>
